# Get a free id at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=
# Factory addresses from contracts-pkg/deployments.json
VITE_FACTORY_SEPOLIA=
VITE_FACTORY_BASE_SEPOLIA=
# Optional: Pinata JWT to pin subscriber airdrop lists to IPFS (falls back to browser storage if empty)
VITE_PINATA_JWT=
# Local testing: run `npx hardhat node` + seed-local script in contracts-pkg, then set these
VITE_ENABLE_LOCAL=false
VITE_FACTORY_LOCAL=
